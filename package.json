{
  "name": "goalguard",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Goal-first downside protection powered by Gonka and Thetanuts.",
  "engines": {
    "node": ">=22.0.0"
  },
  "packageManager": "pnpm@11.19.0",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:install": "playwright install chromium",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:studio": "drizzle-kit studio",
    "smoke:gonka": "tsx scripts/smoke-gonka.ts",
    "smoke:thetanuts": "tsx scripts/smoke-thetanuts.ts",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm build"
  },
  "dependencies": {
    "@thetanuts-finance/thetanuts-client": "0.2.3",
    "decimal.js": "10.6.0",
    "drizzle-orm": "1.0.0-rc.4",
    "ethers": "6.17.0",
    "next": "16.3.3",
    "openai": "7.8.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "0.0.1",
    "zod": "4.1.11"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@tailwindcss/postcss": "4.3.3",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.0",
    "@testing-library/user-event": "14.6.1",
    "@types/node": "22.19.13",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "drizzle-kit": "1.0.0-rc.4",
    "eslint": "9.39.4",
    "eslint-config-next": "16.3.3",
    "jsdom": "28.1.0",
    "tailwindcss": "4.3.3",
    "tsx": "4.21.0",
    "typescript": "5.9.3",
    "vitest": "4.1.11"
  }
}
