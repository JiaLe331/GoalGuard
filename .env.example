# Gonka (server-only)
GONKA_API_KEY=
GONKA_BASE_URL=
GONKA_STRATEGIST_MODEL=
GONKA_RISK_AUDITOR_MODEL=
GONKA_CONSUMER_ADVOCATE_MODEL=
GONKA_REQUEST_ID_HEADER=x-request-id

# Base / Thetanuts
# Alchemy Base Mainnet URL (primary; server-only)
THETANUTS_RPC_URL=
# Infura Base Mainnet URL (fallback; server-only; never use the public Base RPC)
THETANUTS_RPC_FALLBACK_URL=
THETANUTS_REFERRER_ADDRESS=
NEXT_PUBLIC_BASE_CHAIN_ID=8453

# Safety: mandatory for the submitted and demonstrated build; this is not an approval switch.
ENABLE_LIVE_THETANUTS_EXECUTION=false
# Applied to the proposed unsigned preview; no real trade is broadcast.
MAX_LIVE_TRADE_PREMIUM_USD=3
MAX_DEADLINE_GAP_HOURS=168

# Application
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional local real-integration workflow smoke test (public address only; never a private key)
GOALGUARD_SMOKE_APP_URL=http://localhost:3000
GOALGUARD_SMOKE_WALLET_ADDRESS=
GOALGUARD_SMOKE_GOAL_MESSAGE=

# Supabase PostgreSQL: transaction pooler for Vercel, direct/session URL for migrations
DATABASE_URL=postgresql://postgres.PROJECT:PASSWORD@REGION.pooler.supabase.com:6543/postgres
DATABASE_DIRECT_URL=postgresql://postgres:PASSWORD@db.PROJECT.supabase.co:5432/postgres

# Render background worker
TRADE_WORKER_NAME=trade-monitor
TRADE_WORKER_POLL_MS=5000
TRADE_WORKER_HEARTBEAT_MS=15000
MARKET_SNAPSHOT_MS=900000

# Optional. One goal that any visitor may READ, so a shared link or a fresh browser lands on a
# populated workspace instead of an ownership error. Writes always stay scoped to the caller.
DEMO_GOAL_ID=

# Presentation flow (live demo only -- DELETE after the demo).
# Arms the compressed replay of one recorded run; a tab activates it with ?flow=fast.
NEXT_PUBLIC_PRESENTATION_FLOW=
# Optional: a Base address you control, shown as the connected wallet in that flow.
NEXT_PUBLIC_PRESENTATION_WALLET=
